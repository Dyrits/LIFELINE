{
  "name": "lifeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && biome check . && vitest run",
    "dev": "vite",
    "e2e": "playwright test",
    "format": "biome check --write .",
    "prepare": "git config core.hooksPath .githooks",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
